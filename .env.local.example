# Copy to .env.local and fill in real values. Never commit .env.local.
#
# NOTE: `vercel env pull` will NOT recover these — Vercel stores them as
# "Sensitive" (write-only) and returns the literal string "[SENSITIVE]".
# If you lose .env.local, regenerate each key from the source below.

# Neon Postgres connection string.
# Neon dashboard -> your project -> Connect. Make sure you pick the right
# database (this project's tables live in `neondb` and are prefixed `tv_`);
# the same Neon instance also hosts unrelated projects' tables.
DATABASE_URL=

# TMDB v4 "API Read Access Token" (the long JWT-looking one), from
# themoviedb.org -> Settings -> API. Used for movie search, posters,
# synopses, and streaming availability.
# The shorter v3 "API Key" is NOT used anywhere in this codebase.
TMDB_READ_ACCESS_TOKEN=

# Google Gemini API key, from aistudio.google.com -> Get API key.
# Used only for synopsis generation/refinement on a nomination.
GEMINI_API_KEY=
